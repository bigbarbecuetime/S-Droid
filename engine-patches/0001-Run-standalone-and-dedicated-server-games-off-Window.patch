diff --git a/engine/Sandbox.Engine/Platform/Standalone/Standalone.cs b/engine/Sandbox.Engine/Platform/Standalone/Standalone.cs
index d8f038e5..8fbe8495 100644
--- a/engine/Sandbox.Engine/Platform/Standalone/Standalone.cs
+++ b/engine/Sandbox.Engine/Platform/Standalone/Standalone.cs
@@ -25,6 +25,13 @@ public static class Standalone
 	/// </summary>
 	internal const string ProjectConfigResourceName = "STANDALONE_PROJECT";
 
+	/// <summary>
+	/// Where Linux and Android builds keep what Windows builds put in the executable's resources: the
+	/// manifest and project config, in the game's root folder. An ELF apphost has no resource section
+	/// to carry them. <c>SBOX_STANDALONE_IDENTITY</c> points somewhere else.
+	/// </summary>
+	internal const string IdentityFileName = "standalone.json";
+
 	/// <summary>
 	/// If running in standalone, contains the properties of the standalone game
 	/// </summary>
@@ -53,12 +60,59 @@ public static class Standalone
 	/// </summary>
 	internal static void LoadFromExecutable()
 	{
+		if ( !OperatingSystem.IsWindows() )
+		{
+			LoadFromIdentityFile();
+			return;
+		}
+
 		var manifestJson = ReadResource( ManifestResourceName );
 		ProjectConfigJson = ReadResource( ProjectConfigResourceName );
 
 		SetupFromManifest( JsonSerializer.Deserialize<StandaloneManifest>( manifestJson ) );
 	}
 
+	static void LoadFromIdentityFile()
+	{
+		var path = Environment.GetEnvironmentVariable( "SBOX_STANDALONE_IDENTITY" );
+		if ( string.IsNullOrEmpty( path ) )
+			path = Path.Combine( Environment.CurrentDirectory, IdentityFileName );
+
+		if ( !File.Exists( path ) )
+			throw new FileNotFoundException( $"No standalone identity at '{path}' - it wasn't produced by the standalone exporter" );
+
+		var (manifest, projectJson) = ParseIdentity( File.ReadAllText( path ) );
+		ProjectConfigJson = projectJson;
+		SetupFromManifest( manifest );
+	}
+
+	/// <summary>
+	/// Read <see cref="IdentityFileName"/>: <c>{ "Manifest": { ... }, "Project": { ... } }</c>, where
+	/// Project is the game's <c>.sbproj</c> as exported.
+	/// </summary>
+	internal static (StandaloneManifest Manifest, string ProjectJson) ParseIdentity( string json )
+	{
+		using var document = JsonDocument.Parse( json );
+		var root = document.RootElement;
+
+		if ( !root.TryGetProperty( "Manifest", out var manifest ) || manifest.ValueKind != JsonValueKind.Object )
+			throw new InvalidDataException( "Standalone identity has no Manifest object" );
+
+		if ( !root.TryGetProperty( "Project", out var project ) || project.ValueKind != JsonValueKind.Object )
+			throw new InvalidDataException( "Standalone identity has no Project object" );
+
+		return (manifest.Deserialize<StandaloneManifest>(), project.GetRawText());
+	}
+
+	/// <summary>
+	/// The inverse of <see cref="ParseIdentity"/>, for exporters.
+	/// </summary>
+	internal static string WriteIdentity( StandaloneManifest manifest, string projectJson )
+	{
+		using var project = JsonDocument.Parse( projectJson );
+		return JsonSerializer.Serialize( new { Manifest = manifest, Project = project.RootElement }, new JsonSerializerOptions { WriteIndented = true } );
+	}
+
 	[DllImport( "kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode )]
 	private static extern IntPtr FindResource( IntPtr hModule, string lpName, IntPtr lpType );
 
@@ -75,9 +129,6 @@ public static class Standalone
 
 	private static string ReadResource( string name )
 	{
-		if ( !OperatingSystem.IsWindows() )
-			throw new PlatformNotSupportedException( "Standalone games are currently exported for Windows only" );
-
 		// The main module - the exe itself, which is where the exporter put the resources
 		var module = IntPtr.Zero;
 
