+			var libraryFolders = Directory.Exists( libraries ) ? Directory.EnumerateDirectories( libraries ) : [];
+			foreach ( var folder in libraryFolders )
 			{
 				var configs = Directory.EnumerateFiles( folder, "*.sbproj" ).ToArray();
 				if ( configs.Length != 1 ) continue;
diff --git a/engine/Tests/Sandbox.Test.Unit/Standalone/StandaloneIdentityTests.cs b/engine/Tests/Sandbox.Test.Unit/Standalone/StandaloneIdentityTests.cs
new file mode 100644
index 00000000..ebd7656a
--- /dev/null
+++ b/engine/Tests/Sandbox.Test.Unit/Standalone/StandaloneIdentityTests.cs
@@ -0,0 +1,64 @@
+using Sandbox;
+using System;
+using System.IO;
+using System.Text.Json;
+
+namespace StandaloneTests;
+
+[TestClass]
+public class StandaloneIdentityTests
+{
+	const string Project = """{"Title":"Space Wars","Ident":"spacewars","Org":"local","Type":"game","Metadata":{"ControlModes":{"VR":true}}}""";
+
+	[TestMethod]
+	public void RoundTrips()
+	{
+		var manifest = new StandaloneManifest
+		{
+			Name = "Space Wars",
+			Ident = "local.spacewars",
+			ExecutableName = "spacewars",
+			AppId = 480,
+			BuildDate = new DateTime( 2026, 10, 11, 12, 0, 0, DateTimeKind.Utc ),
+			IsVRProject = true,
+		};
+
+		var (back, projectJson) = Standalone.ParseIdentity( Standalone.WriteIdentity( manifest, Project ) );
+
+		Assert.AreEqual( "local.spacewars", back.Ident );
+		Assert.AreEqual( "Space Wars", back.Name );
+		Assert.AreEqual( 480ul, back.AppId );
+		Assert.AreEqual( manifest.BuildDate, back.BuildDate );
+		Assert.IsTrue( back.IsVRProject );
+
+		// The project config comes back as JSON with the same content, nested objects included
+		using var expected = JsonDocument.Parse( Project );
+		using var actual = JsonDocument.Parse( projectJson );
+		Assert.AreEqual( expected.RootElement.GetProperty( "Ident" ).GetString(), actual.RootElement.GetProperty( "Ident" ).GetString() );
+		Assert.IsTrue( actual.RootElement.GetProperty( "Metadata" ).GetProperty( "ControlModes" ).GetProperty( "VR" ).GetBoolean() );
+	}
+
+	[TestMethod]
+	[DataRow( """{"Project":{}}""" )]
+	[DataRow( """{"Manifest":{}}""" )]
+	[DataRow( """{"Manifest":"x","Project":{}}""" )]
+	[DataRow( """{"Manifest":{},"Project":"{}"}""" )]
+	public void MissingOrWrongSectionsAreRejected( string json )
+	{
+		Assert.ThrowsException<InvalidDataException>( () => Standalone.ParseIdentity( json ) );
+	}
+
+	[TestMethod]
+	public void NotJsonIsRejected()
+	{
+		// JsonDocument throws an internal subtype, so ThrowsException<JsonException> (exact type) can't match
+		try
+		{
+			Standalone.ParseIdentity( "not json" );
+			Assert.Fail( "expected a JsonException" );
+		}
+		catch ( JsonException )
+		{
+		}
+	}
+}
